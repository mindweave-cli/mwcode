abi <abi/4.0>,
include <tunables/global>

# Ubuntu 24.04 and later only let listed programs make the user namespaces Chromium's sandbox needs.
# /opt/mwcode/mwcode is the launcher script; the app itself is mwcode-bin.
profile "${executable}" "/opt/${sanitizedProductName}/${executable}-bin" flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/${executable}>
}
